{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    
    /* Add these configuration options */
    "rootDir": "./src",               /* Where your TypeScript source files live */
    "outDir": "./dist",               /* Where compiled JavaScript files will go */
    "sourceMap": true                 /* Helpful for debugging compiled code */
  },
  "include": ["src/**/*"]             /* Tells TS to only compile files inside src */
}